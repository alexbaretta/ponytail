import fcntl
import hashlib
import json
import os
import re
import shlex
import subprocess
import sys
import tempfile
from pathlib import Path


def fail(message):
    raise ValueError(message)


def path_has_symlink(path):
    current = path
    while current != current.parent:
        if current.is_symlink():
            return True
        current = current.parent
    return False


def valid_source_root(path):
    return all((path / relative).is_file() for relative in (
        "cli/ponytail",
        "cli/condense_codex_rules.sh",
        "scripts/install-to-codex.sh",
        "registry.tsv",
    ))


def exact_config(value, config_path):
    if not isinstance(value, dict) or set(value) != {"schemaVersion", "sourceRoot", "projects"}:
        fail(f"invalid V1 Ponytail configuration: {config_path}")
    if value["schemaVersion"] != 1 or not isinstance(value["sourceRoot"], str) or not Path(value["sourceRoot"]).is_absolute():
        fail(f"invalid V1 Ponytail configuration: {config_path}")
    projects = value["projects"]
    if not isinstance(projects, list):
        fail(f"invalid V1 Ponytail configuration: {config_path}")
    for project in projects:
        if not isinstance(project, dict) or set(project) != {"root", "blessedWorktree"} or not isinstance(project["root"], str) or not Path(project["root"]).is_absolute() or (project["blessedWorktree"] is not None and (not isinstance(project["blessedWorktree"], str) or not Path(project["blessedWorktree"]).is_absolute())):
            fail(f"invalid V1 Ponytail configuration: {config_path}")
    roots = [project["root"] for project in projects]
    if roots != sorted(set(roots)):
        fail(f"invalid V1 Ponytail configuration: {config_path}")
    return value


def read_config(config_path):
    if not config_path.exists():
        return None
    if path_has_symlink(config_path) or not config_path.is_file():
        fail(f"Ponytail configuration must be a regular non-symlink file: {config_path}")
    try:
        return exact_config(json.loads(config_path.read_text(encoding="utf-8")), config_path)
    except json.JSONDecodeError as error:
        fail(f"invalid V1 Ponytail configuration {config_path}: {error}")
    except TypeError:
        fail(f"invalid V1 Ponytail configuration: {config_path}")


def atomic_write_text(target, text, mode):
    if path_has_symlink(target) or (target.exists() and not target.is_file()):
        fail(f"refusing to replace non-regular or symlink path: {target}")
    target.parent.mkdir(parents=True, exist_ok=True)
    descriptor, temporary = tempfile.mkstemp(prefix=f".{target.name}.", dir=target.parent)
    try:
        with os.fdopen(descriptor, "w", encoding="utf-8") as output:
            output.write(text)
            output.flush()
            os.fsync(output.fileno())
        os.chmod(temporary, mode)
        os.replace(temporary, target)
    finally:
        if os.path.exists(temporary):
            os.unlink(temporary)


def atomic_write(config_path, value, mode=0o600):
    atomic_write_text(config_path, f"{json.dumps(value, indent=2, sort_keys=True)}\n", mode)


def source_root_for(script_path, config):
    candidate = script_path.resolve().parent.parent
    if valid_source_root(candidate):
        return candidate
    if config is None:
        fail("Ponytail source is not configured; run scripts/install-cli.sh from the Ponytail repository")
    source_root = Path(config["sourceRoot"])
    if path_has_symlink(source_root) or not source_root.is_dir() or not valid_source_root(source_root):
        fail(f"configured Ponytail source is unavailable: {source_root}")
    return source_root


def write_config(config_path, source_root, projects):
    atomic_write(config_path, {
        "schemaVersion": 1,
        "sourceRoot": str(source_root.resolve()),
        "projects": sorted(projects, key=lambda project: project["root"]),
    })


class ProjectError(ValueError):
    def __init__(self, message, status):
        super().__init__(message)
        self.status = status


def repository_roots(directory, missing_status=2, env=None):
    result = subprocess.run(["git", "-C", str(directory), "rev-parse", "--show-toplevel"], capture_output=True, text=True, env=env)
    if result.returncode:
        raise ProjectError(f"no Git worktree detected: {directory}", missing_status)
    root = Path(result.stdout.strip()).resolve()
    worktrees = subprocess.run(["git", "-C", str(root), "worktree", "list", "--porcelain", "-z"], capture_output=True, check=True, env=env)
    first = worktrees.stdout.split(b"\0", 1)[0].decode()
    if not first.startswith("worktree "):
        fail("Git did not identify the main checkout")
    return root, Path(first[len("worktree "):]).resolve()


def relative_path(value):
    return isinstance(value, str) and value and not Path(value).is_absolute() and ".." not in value.split("/") and "." not in value.split("/") and "" not in value.split("/") and "\\" not in value


def read_project_version(value, version, keys):
    if not isinstance(value, dict) or set(value) != keys or type(value["schemaVersion"]) is not int or value["schemaVersion"] != version:
        fail(f"invalid V{version} project metadata fields")
    if not isinstance(value["name"], str) or not value["name"].strip():
        fail("project name must be a nonempty string")
    for key in ("names", "components", "repositoryUrls") + (("dependencies",) if version >= 2 else ()):
        items = value[key]
        if not isinstance(items, list) or any(not isinstance(item, str) or not item.strip() or "\n" in item or "\r" in item for item in items) or len(set(items)) != len(items):
            fail(f"{key} must contain unique nonempty strings")
    for key, fields in (("packages", {"manager", "name"}), ("manifests", {"manager", "path"}), ("exceptions", {"project", "name", "path", "reason"})):
        if not isinstance(value[key], list):
            fail(f"{key} must be an array")
        for item in value[key]:
            if not isinstance(item, dict) or set(item) != fields or any(not isinstance(field, str) or not field.strip() or "\n" in field for field in item.values()):
                fail(f"invalid {key} entry")
            if "path" in item and not relative_path(item["path"]):
                fail(f"{key} path must be an exact repository-relative path")
            if "manager" in item and item["manager"] not in {"npm", "pnpm", "pip", "cargo", "brew", "conda"}:
                fail(f"unsupported package manager: {item['manager']}")
    return value


def read_project_v1(value):
    keys = {"schemaVersion", "name", "names", "components", "repositoryUrls", "packages", "manifests", "exceptions"}
    return {**read_project_version(value, 1, keys), "schemaVersion": 2, "dependencies": []}


def read_project_v2(value):
    keys = {"schemaVersion", "name", "names", "components", "dependencies", "repositoryUrls", "packages", "manifests", "exceptions"}
    return read_project_version(value, 2, keys)


PonytailProjectReaders = {1: read_project_v1, 2: read_project_v2}


def read_project(root):
    target = root / ".agents/config/ponytail.json"
    if path_has_symlink(target) or not target.is_file():
        fail(f"missing or unsafe project metadata: {target}; run ponytail register and commit the metadata")
    try:
        value = json.loads(target.read_text(encoding="utf-8"))
        if not isinstance(value, dict) or type(value.get("schemaVersion")) is not int or value["schemaVersion"] not in PonytailProjectReaders:
            fail("unsupported project metadata version")
        return PonytailProjectReaders[value["schemaVersion"]](value)
    except ValueError as error:
        fail(f"{target}: {error}")


def write_project(root, metadata):
    project_metadata = {**metadata, "schemaVersion": 2}
    read_project_v2(project_metadata)
    atomic_write(root / ".agents/config/ponytail.json", project_metadata, 0o644)


def component_identifiers(components):
    identifiers = set()
    for component in components:
        identifiers.add(checked_component_name(component))
        if component.startswith("@") and "/" in component:
            identifiers.add(checked_component_name(component.rsplit("/", 1)[1]))
    return sorted(identifiers)


def registered_project(config, main_root):
    if config is None:
        return None
    return next((project for project in config["projects"] if project["root"] == str(main_root)), None)


def install_precommit_hook(root, source_root, config_path):
    result = subprocess.run(
        ["git", "-C", str(root), "rev-parse", "--path-format=absolute", "--git-path", "hooks/pre-commit"],
        capture_output=True,
        text=True,
        check=True,
    )
    target = Path(result.stdout.strip())
    if path_has_symlink(target) or (target.exists() and not target.is_file()):
        fail(f"pre-commit hook must be a regular non-symlink file: {target}")
    begin = "# ponytail pre-commit: begin\n"
    end = "# ponytail pre-commit: end\n"
    block = f'''{begin}HOME={shlex.quote(str(config_path.parent.parent))} {shlex.quote(str(source_root / "cli/ponytail"))} qa || exit $?
{end}'''
    standalone = f'''#!/usr/bin/env bash
set -euo pipefail

main() {{
{block}  exit 0
}}

main "$@"
'''
    existing = target.read_text(encoding="utf-8") if target.exists() else None
    old_prefix = "#!/usr/bin/env bash\nset -euo pipefail\n# Managed by ponytail register.\n"
    if existing is None or existing.startswith(old_prefix):
        updated = standalone
    elif begin in existing or end in existing:
        if existing.count(begin) != 1 or existing.count(end) != 1 or existing.index(begin) > existing.index(end):
            fail(f"invalid Ponytail block in pre-commit hook: {target}")
        finish = existing.index(end) + len(end)
        updated = existing[:existing.index(begin)] + block + existing[finish:]
    else:
        first_line = existing.partition("\n")[0]
        if not re.match(r"^#![^\r\n]*(?:/|[ \t])(?:sh|bash|dash|ksh|zsh)(?:[ \t]|$)", first_line):
            fail(f"existing pre-commit hook is not a supported shell script: {target}")
        split = existing.find("\n")
        updated = existing + "\n" + block if split < 0 else existing[:split + 1] + block + existing[split + 1:]
    if existing != updated:
        mode = 0o755 if existing is None else (target.stat().st_mode & 0o777) | 0o111
        atomic_write_text(target, updated, mode)
    elif not os.access(target, os.X_OK):
        target.chmod((target.stat().st_mode & 0o777) | 0o111)
    print(f"pre-commit hook: {target}")


def register(config_path, source_root, root, main_root):
    proposal_path = root / ".agents/config/codex-execpolicy.json"
    if path_has_symlink(proposal_path) or (proposal_path.exists() and not proposal_path.is_file()):
        fail(f"project policy must be a regular non-symlink file: {proposal_path}")
    if not proposal_path.exists():
        atomic_write(proposal_path, {"schemaVersion": 1, "safe": [], "unsafe": []}, 0o644)
        print(f"initialized: {proposal_path}")
    metadata_path = root / ".agents/config/ponytail.json"
    if not metadata_path.exists() and not metadata_path.is_symlink():
        write_project(root, {"name": main_root.name, "names": [], "components": [], "dependencies": [], "repositoryUrls": [], "packages": [], "manifests": [], "exceptions": []})
        print(f"initialized: {metadata_path}")
    read_project(root)
    config = read_config(config_path)
    projects = [] if config is None else config["projects"]
    registered = registered_project(config, main_root)
    if registered is None:
        projects = [*projects, {"root": str(main_root), "blessedWorktree": str(root)}]
    elif registered["blessedWorktree"] is None:
        projects = [{**project, "blessedWorktree": str(root)} if project["root"] == str(main_root) else project for project in projects]
    write_config(config_path, source_root, projects)
    if registered is not None and registered["blessedWorktree"] is None:
        print(f"blessed worktree: {root}")
    print(f"{'registered' if registered is None else 'already registered'}: {main_root}")


def checked_component_name(value):
    if not isinstance(value, str) or not value or value != value.strip() or "\n" in value or "\r" in value:
        fail("component name must be a nonempty string without surrounding whitespace")
    return value


def update_project_names(root, field, kind, name, additions, remove):
    lock_name = hashlib.sha256(str(root).encode()).hexdigest()
    with open(Path(tempfile.gettempdir()) / f"ponytail-project-{lock_name}.lock", "a+", encoding="utf-8") as lock:
        fcntl.flock(lock.fileno(), fcntl.LOCK_EX)
        metadata = read_project(root)
        values = set(metadata[field])
        if remove:
            if name not in values:
                fail(f"{kind} is not registered: {name}")
            values.remove(name)
        else:
            already_registered = name in values
            values.update(additions)
        write_project(root, {**metadata, field: sorted(values)})
    if remove:
        print(f"unregistered {kind}: {name}")
    else:
        print(f"{'already registered' if already_registered else 'registered'} {kind}: {name}")


def update_component(root, name, remove):
    name = checked_component_name(name)
    update_project_names(root, "components", "component", name, component_identifiers([name]), remove)


def registered_dependency_names(config, main_root):
    names = set()
    for project in config["projects"]:
        if project["root"] == str(main_root):
            continue
        _, metadata = blessed_project(project)
        if metadata["name"] in names:
            fail("registered projects must have unique canonical names")
        names.add(metadata["name"])
    return names


def update_dependency(root, main_root, config, name, remove):
    if not name or name != name.strip() or "\n" in name or "\r" in name:
        fail("dependency name must be a canonical nonempty project name without surrounding whitespace")
    if name not in registered_dependency_names(config, main_root):
        fail(f"project is not registered: {name}")
    update_project_names(root, "dependencies", "dependency", name, [name], remove)


def detected_package_names(root):
    result = subprocess.run(["git", "-C", str(root), "ls-files", "--stage", "-z"], capture_output=True, check=True)
    paths = []
    for entry in result.stdout.decode().split("\0"):
        if not entry:
            continue
        header, separator, relative = entry.partition("\t")
        if not separator or Path(relative).name != "package.json":
            continue
        mode, _, stage = header.split(" ")
        if mode not in {"100644", "100755"} or stage != "0":
            fail(f"package manifest must be a tracked regular file without conflicts: {relative}")
        paths.append(relative)
    if not paths:
        fail("no tracked package.json files found")
    names = set()
    for relative in sorted(paths):
        target = root / relative
        if path_has_symlink(target) or not target.is_file():
            fail(f"package manifest must be a regular non-symlink file: {relative}")
        try:
            package = json.loads(target.read_text(encoding="utf-8"))
        except json.JSONDecodeError as error:
            fail(f"invalid package manifest {relative}: {error}")
        if not isinstance(package, dict):
            fail(f"package manifest must contain an object: {relative}")
        if "name" not in package:
            continue
        names.add(checked_component_name(package["name"]))
    return sorted(names)


def detect_components(root, arguments):
    if not arguments:
        language = "auto"
    elif len(arguments) == 2 and arguments[0] == "--language":
        language = arguments[1]
    else:
        fail("usage: ponytail detect-components [--language typescript|javascript|auto]")
    if language not in {"typescript", "javascript", "auto"}:
        fail(f"unsupported component detection language: {language}")
    names = detected_package_names(root)
    lock_name = hashlib.sha256(str(root).encode()).hexdigest()
    with open(Path(tempfile.gettempdir()) / f"ponytail-project-{lock_name}.lock", "a+", encoding="utf-8") as lock:
        fcntl.flock(lock.fileno(), fcntl.LOCK_EX)
        metadata = read_project(root)
        components = sorted(set(metadata["components"]) | set(component_identifiers(names)))
        write_project(root, {**metadata, "components": components})
    for name in names:
        print(name)


def tracked_project(root, env=None):
    for relative in (".agents/config/ponytail.json", ".agents/config/codex-execpolicy.json"):
        tracked = subprocess.run(["git", "-C", str(root), "ls-files", "--error-unmatch", "--", relative], capture_output=True, env=env)
        if tracked.returncode:
            fail(f"project configuration must be tracked in Git: {root / relative}")
    return read_project(root)


def tracked_clean_project(root, env=None):
    metadata = tracked_project(root, env)
    relative = ".agents/config"
    changed = subprocess.run(["git", "-C", str(root), "status", "--porcelain", "--", relative], capture_output=True, text=True, check=True, env=env)
    if changed.stdout:
        fail(f"project configuration must be committed before blessing: {root / relative}")
    return metadata


def blessed_project(project):
    if project["blessedWorktree"] is None:
        fail(f"repository has no blessed worktree: {project['root']}; run ponytail register from that repository or one of its worktrees")
    blessed = Path(project["blessedWorktree"])
    # Hooks export repository-local Git variables, including a temporary commit index.
    local_variables = subprocess.run(["git", "rev-parse", "--local-env-vars"], capture_output=True, text=True, check=True).stdout.splitlines()
    env = {key: value for key, value in os.environ.items() if key not in local_variables}
    if not blessed.is_dir() or repository_roots(blessed, 1, env)[1] != Path(project["root"]):
        fail(f"blessed worktree is unavailable or belongs to another repository: {blessed}")
    return blessed, tracked_clean_project(blessed, env)


def bless(config_path, source_root, config, root, main_root):
    project = registered_project(config, main_root)
    if project is None:
        raise ProjectError(f"Git repository is not registered with Ponytail: {main_root}; run ponytail register", 3)
    tracked_clean_project(root)
    projects = [{**candidate, "blessedWorktree": str(root)} if candidate["root"] == str(main_root) else candidate for candidate in config["projects"]]
    write_config(config_path, source_root, projects)
    print(f"blessed worktree: {root}")


def blessed(config, main_root):
    project = registered_project(config, main_root)
    if project is None:
        raise ProjectError(f"Git repository is not registered with Ponytail: {main_root}; run ponytail register", 3)
    if project["blessedWorktree"] is None:
        fail(f"repository has no blessed worktree: {main_root}; run ponytail register from this worktree")
    print(project["blessedWorktree"])


def validate_project(config, source_root, root, main_root):
    project = registered_project(config, main_root)
    if project is None:
        raise ProjectError(f"Git repository is not registered with Ponytail: {main_root}; run ponytail register", 3)
    metadata = tracked_project(root)
    result = subprocess.run([str(source_root / "cli/condense_codex_rules.sh"), "--validate-project", str(root)], capture_output=True, text=True)
    if result.returncode:
        fail(result.stderr.strip() or "invalid project policy")
    return metadata


def qa(source_root, config, root, main_root, metadata, arguments):
    if arguments not in ([], ["references"]):
        fail("usage: ponytail qa [references]")
    _, source_main_root = repository_roots(source_root)
    projects = {}
    for project in config["projects"]:
        if project["root"] in {str(main_root), str(source_main_root)}:
            continue
        _, foreign = blessed_project(project)
        projects[project["root"]] = foreign
    names = [metadata["name"], *(item["name"] for item in projects.values())]
    if len(set(names)) != len(names):
        fail("registered projects must have unique canonical names")
    return subprocess.run(["node", str(source_root / "scripts/project-qa.js")], input=json.dumps({"root": str(root), "project": metadata, "projects": projects}), text=True).returncode


def update_skills(source_root, arguments):
    return subprocess.call([str(source_root / "scripts/install-to-codex.sh"), *arguments])


def update_permissions(source_root, config, arguments):
    if "--project" in arguments or "--replace-projects" in arguments:
        fail("update-permissions gets projects only from Ponytail registration")
    command = [str(source_root / "cli/condense_codex_rules.sh"), "--replace-projects"]
    for project in ([] if config is None else config["projects"]):
        blessed, _ = blessed_project(project)
        command.extend(["--project", str(blessed)])
    return subprocess.call([*command, *arguments])


def print_usage():
    print("""Usage:
  ponytail register
  ponytail bless[-worktree]
  ponytail blessed[-worktree]
  ponytail register-component <name>
  ponytail unregister-component <name>
  ponytail register-dependency <project>
  ponytail unregister-dependency <project>
  ponytail detect-components [--language typescript|javascript|auto]
  ponytail pre-commit
  ponytail validate
  ponytail qa [references]
  ponytail update-permissions [permission options]
  ponytail update-skills [Codex installer options]
  ponytail update

All commands require a Git worktree. Only register may run before registration.
validate checks setup only; qa runs local checks, never integration suites.
Exit statuses: 1 invalid setup/command, 2 no Git worktree, 3 unregistered, 4 QA findings.""")


def run():
    script_path = Path(sys.argv[1])
    arguments = sys.argv[2:]
    root, main_root = repository_roots(Path.cwd())
    operation = arguments.pop(0) if arguments else "help"
    home_value = os.environ.get("HOME")
    if not home_value:
        fail("HOME is required")
    home = Path(home_value).expanduser().resolve()
    config_path = home / ".ponytail/config.json"
    if operation == "register":
        if arguments:
            fail("register accepts no arguments")
        lock_name = hashlib.sha256(str(home).encode()).hexdigest()
        with open(Path(tempfile.gettempdir()) / f"ponytail-{lock_name}.lock", "a+", encoding="utf-8") as lock:
            fcntl.flock(lock.fileno(), fcntl.LOCK_EX)
            config = read_config(config_path)
            register(config_path, source_root_for(script_path, config), root, main_root)
        return 0
    config = read_config(config_path)
    source_root = source_root_for(script_path, config)
    if operation in {"bless", "bless-worktree"}:
        if arguments:
            fail(f"{operation} accepts no arguments")
        lock_name = hashlib.sha256(str(home).encode()).hexdigest()
        with open(Path(tempfile.gettempdir()) / f"ponytail-{lock_name}.lock", "a+", encoding="utf-8") as lock:
            fcntl.flock(lock.fileno(), fcntl.LOCK_EX)
            config = read_config(config_path)
            bless(config_path, source_root, config, root, main_root)
        return 0
    if operation in {"blessed", "blessed-worktree"}:
        if arguments:
            fail(f"{operation} accepts no arguments")
        blessed(config, main_root)
        return 0
    if operation in {"register-component", "unregister-component", "register-dependency", "unregister-dependency", "detect-components"}:
        if registered_project(config, main_root) is None:
            raise ProjectError(f"Git repository is not registered with Ponytail: {main_root}; run ponytail register", 3)
        read_project(root)
        if operation == "register-component":
            if len(arguments) != 1:
                fail("usage: ponytail register-component <name>")
            update_component(root, arguments[0], False)
        elif operation == "unregister-component":
            if len(arguments) != 1:
                fail("usage: ponytail unregister-component <name>")
            update_component(root, arguments[0], True)
        elif operation in {"register-dependency", "unregister-dependency"}:
            if len(arguments) != 1:
                fail(f"usage: ponytail {operation} <project>")
            update_dependency(root, main_root, config, arguments[0], operation == "unregister-dependency")
        else:
            detect_components(root, arguments)
        return 0
    metadata = validate_project(config, source_root, root, main_root)
    if operation in {"-h", "--help", "help"}:
        print_usage()
        return 0
    if operation == "validate":
        if arguments:
            fail("validate accepts no arguments")
        print(f"valid: {root} (registered main checkout: {main_root})")
        return 0
    if operation == "pre-commit":
        if arguments:
            fail("pre-commit accepts no arguments")
        install_precommit_hook(root, source_root, config_path)
        return 0
    if operation == "qa":
        return qa(source_root, config, root, main_root, metadata, arguments)
    if operation == "update-skills":
        return update_skills(source_root, arguments)
    if operation == "update-permissions":
        return update_permissions(source_root, config, arguments)
    if operation == "update":
        if arguments:
            fail("update accepts no arguments")
        status = update_skills(source_root, [])
        if status != 0:
            return status
        return update_permissions(source_root, config, [])
    fail(f"unknown command: {operation}")


try:
    sys.exit(run())
except ProjectError as error:
    print(f"error: {error}", file=sys.stderr)
    sys.exit(error.status)
except (OSError, ValueError, subprocess.CalledProcessError) as error:
    print(f"error: {error}", file=sys.stderr)
    sys.exit(1)
