    }
  ],
  "maintainers": [
    {
      "name": "Alex Baretta",
      "email": "alex@baretta.com",
      "url": "https://github.com/alexbaretta"
    }
  ],
  "homepage": "https://github.com/alexbaretta/ponytail",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/alexbaretta/ponytail.git"
  },
  "bugs": {
    "url": "https://github.com/alexbaretta/ponytail/issues"
  },
  "main": "./.opencode/plugins/ponytail.mjs",
  "exports": {
    ".": "./.opencode/plugins/ponytail.mjs",
    "./plugin": "./.opencode/plugins/ponytail.mjs"
  },
  "files": [
    "AGENTS.md",
    "hooks/",
    "skills/",
    ".opencode/",
    ".qoder/",
    ".qoder-plugin/",
    "pi-extension/",
    "scripts/uninstall.js",
    "assets/",
    "LICENSE"
  ],
  "scripts": {
    "test": "npm run test:core",
    "test:core": "node scripts/registry.js && node scripts/build-command-adapters.js && node scripts/check-rule-copies.js && node --test tests/*.test.js && npm test --prefix pi-extension && npm test --prefix ponytail-mcp",
    "test:benchmarks": "node --test benchmarks/*.test.js"
  },
  "pi": {
    "extensions": ["./pi-extension/index.js"],
    "skills": ["./skills"]
  },
  "publishConfig": {
    "access": "public"
  }
}
