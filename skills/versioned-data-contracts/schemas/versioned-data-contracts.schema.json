{
  "$comment": "Copyright (c) 2026 Alex Baretta. Licensed under the MIT License.",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/alexbaretta/ponytail/main/skills/versioned-data-contracts/schemas/versioned-data-contracts.schema.json",
  "title": "Versioned data contract requirements",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "families"],
  "properties": {
    "$schema": {
      "type": "string"
    },
    "schemaVersion": {
      "const": 1
    },
    "families": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/family"
      }
    }
  },
  "$defs": {
    "nonemptyString": {
      "type": "string",
      "minLength": 1
    },
    "uniqueVersions": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/nonemptyString"
      },
      "uniqueItems": true
    },
    "implementation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["workspace", "module", "readerRegistryExport"],
      "properties": {
        "workspace": {
          "$ref": "#/$defs/nonemptyString"
        },
        "module": {
          "$ref": "#/$defs/nonemptyString"
        },
        "readerRegistryExport": {
          "$ref": "#/$defs/nonemptyString"
        },
        "downgradeRegistryExport": {
          "$ref": "#/$defs/nonemptyString"
        }
      }
    },
    "fullTextProjection": {
      "type": "object",
      "additionalProperties": false,
      "required": ["supportedProjectionVersions", "policyId"],
      "properties": {
        "supportedProjectionVersions": {
          "$ref": "#/$defs/uniqueVersions"
        },
        "policyId": {
          "$ref": "#/$defs/nonemptyString"
        },
        "projectorRegistryReference": {
          "$ref": "#/$defs/nonemptyString"
        }
      }
    },
    "family": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "implementation",
        "currentVersion",
        "versions",
        "supportedReadVersions",
        "supportedDowngradeVersions"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/nonemptyString"
        },
        "implementation": {
          "$ref": "#/$defs/implementation"
        },
        "currentVersion": {
          "$ref": "#/$defs/nonemptyString"
        },
        "versions": {
          "$ref": "#/$defs/uniqueVersions"
        },
        "supportedReadVersions": {
          "$ref": "#/$defs/uniqueVersions"
        },
        "supportedDowngradeVersions": {
          "$ref": "#/$defs/uniqueVersions"
        },
        "fullTextProjection": {
          "$ref": "#/$defs/fullTextProjection"
        }
      }
    }
  }
}
