{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/alexbaretta/ponytail/skills/debugging/references/pattern-observation.schema.json",
  "$comment": "Copyright (c) 2026 Alex Baretta. All rights reserved. Licensed under the MIT License.",
  "title": "Ponytail Bug-Pattern Observation",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "observation_id",
    "recorded_at",
    "source_references",
    "context",
    "observed_behavior",
    "expected_behavior",
    "causal_mechanism",
    "anti_pattern",
    "correct_pattern",
    "applicability_conditions",
    "known_non_matches",
    "confirmation_evidence",
    "regression_proofs"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "observation_id": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}-[a-z0-9]+(?:_[a-z0-9]+)*$"
    },
    "recorded_at": {
      "type": "string",
      "format": "date-time"
    },
    "source_references": {
      "$ref": "#/$defs/nonemptyStrings"
    },
    "context": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "languages",
        "frameworks",
        "components",
        "affected_boundaries",
        "code_references"
      ],
      "properties": {
        "languages": {
          "$ref": "#/$defs/strings"
        },
        "frameworks": {
          "$ref": "#/$defs/strings"
        },
        "components": {
          "$ref": "#/$defs/strings"
        },
        "affected_boundaries": {
          "$ref": "#/$defs/strings"
        },
        "code_references": {
          "$ref": "#/$defs/strings"
        }
      }
    },
    "observed_behavior": {
      "$ref": "#/$defs/nonemptyString"
    },
    "expected_behavior": {
      "$ref": "#/$defs/nonemptyString"
    },
    "causal_mechanism": {
      "$ref": "#/$defs/nonemptyString"
    },
    "anti_pattern": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "structural_description",
        "why_it_fails"
      ],
      "properties": {
        "structural_description": {
          "$ref": "#/$defs/nonemptyString"
        },
        "why_it_fails": {
          "$ref": "#/$defs/nonemptyString"
        }
      }
    },
    "correct_pattern": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "required_invariant",
        "implementation_description"
      ],
      "properties": {
        "required_invariant": {
          "$ref": "#/$defs/nonemptyString"
        },
        "implementation_description": {
          "$ref": "#/$defs/nonemptyString"
        }
      }
    },
    "applicability_conditions": {
      "$ref": "#/$defs/nonemptyStrings"
    },
    "known_non_matches": {
      "$ref": "#/$defs/strings"
    },
    "confirmation_evidence": {
      "$ref": "#/$defs/nonemptyStrings"
    },
    "regression_proofs": {
      "$ref": "#/$defs/nonemptyStrings"
    }
  },
  "$defs": {
    "nonemptyString": {
      "type": "string",
      "minLength": 1
    },
    "strings": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/nonemptyString"
      },
      "uniqueItems": true
    },
    "nonemptyStrings": {
      "allOf": [
        {
          "$ref": "#/$defs/strings"
        },
        {
          "minItems": 1
        }
      ]
    }
  }
}
